// 이 파일을 Secrets.xcconfig 로 복사한 뒤 값을 채우세요. (Secrets.xcconfig 는 git에 올라가지 않습니다)

// Kakao Developers > 내 애플리케이션 > 앱 키 > 네이티브 앱 키
KAKAO_NATIVE_APP_KEY = your_kakao_native_app_key

// Supabase > Project Settings > API
// xcconfig에서 '//'는 주석이라서 URL은 https:/$()/ 형태로 적어야 합니다.
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
// Publishable key (sb_publishable_...) 또는 legacy anon key
SUPABASE_KEY = your_supabase_publishable_key
